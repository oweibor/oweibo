{
  "name": "@oweibo/module-scaffolding",
  "version": "0.1.0",
  "private": true,
  "description": "oweibo module-scaffolding module — depends only on @oweibo/core-contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@oweibo/core-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.4",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "rimraf": "^5.0.0"
  }
}
