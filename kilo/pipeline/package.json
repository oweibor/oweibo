{
  "name": "kilo-pipeline",
  "version": "0.1.0",
  "description": "Kilo Code — orchestration pipeline service",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit --project tsconfig.test.json",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "dev": "tsc --watch --preserveWatchOutput & node --watch dist/index.js",
    "test": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@oweibo/api-middleware": "workspace:*",
    "@oweibo/core-contracts": "workspace:*",
    "@oweibo/core-engine": "workspace:*",
    "@qdrant/js-client-rest": "^1.12.0",
    "@xenova/transformers": "^2.17.0",
    "ioredis": "^5.3.2",
    "nats": "^2.28.0",
    "chokidar": "^3.6.0",
    "cheerio": "^1.0.0",
    "dockerode": "^4.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "json2csv": "^6.0.0-alpha.2",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.0",
    "socks": "^2.4.4",
    "uuid": "^10.0.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
