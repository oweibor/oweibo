{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir":          "src",
    "outDir":           "dist",
    "module":           "CommonJS",
    "moduleResolution": "Node",
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "dist", "node_modules"]
}
