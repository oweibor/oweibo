{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitReturns": false,
    "isolatedModules": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": [
    "node_modules", "**/dist",
    "scripts/seed-langfuse-prompts.ts",
    "scripts/backfill-tenant-bootstrap.ts",
    "scripts/check-bootstrap-tables.ts",
    "scripts/verify-no-dropped-events.ts"
  ]
}
