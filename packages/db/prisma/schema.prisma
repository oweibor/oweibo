// oweibo Prisma schema
//
// Two schemas in one database:
//   betterauth.*  — managed by BetterAuth; no RLS applied here.
//   oweibo.*      — all tables have RLS enforced via withTenantContext.
//
// RLS is applied through raw SQL migrations (see migrations/).
// Prisma is used only for type-safe access; policy enforcement is at the DB layer.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["betterauth", "oweibo"]
}

// ── betterauth schema (managed by BetterAuth library) ──────────────────────

model BaUser {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions BaSession[]
  accounts BaAccount[]

  @@map("users")
  @@schema("betterauth")
}

model BaSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      BaUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("betterauth")
}

model BaAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  BaUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("accounts")
  @@schema("betterauth")
}

model BaVerification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
  @@schema("betterauth")
}

// BetterAuth multiOrganization plugin tables
model BaOrganization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members     BaMember[]
  invitations BaInvitation[]

  @@map("organizations")
  @@schema("betterauth")
}

model BaMember {
  id             String         @id @default(cuid())
  organizationId String
  organization   BaOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           String
  createdAt      DateTime

  @@map("members")
  @@schema("betterauth")
}

model BaInvitation {
  id             String         @id @default(cuid())
  organizationId String
  organization   BaOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String

  @@map("invitations")
  @@schema("betterauth")
}

// ── oweibo schema (RLS enforced on all tenant-data tables) ─────────────────

// Cross-tenant: no tenant_id; RLS keyed off current_user = 'platform_admin'
model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  status           String   @default("active")
  trustModeDefault String   @default("supervised") @map("trust_mode_default")
  features         Json     @default("{}")
  quotas           Json
  homeRegion       String   @default("us-east-1") @map("home_region")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.Uuid

  memberships  TenantMembership[]
  apiKeys      ApiKey[]
  tasks        Task[]
  settings     TenantSettings?
  taskFeedback TaskFeedback[]
  bootstrap    TenantBootstrap?

  @@map("tenants")
  @@schema("oweibo")
}

// Mirror of betterauth.users; kept in sync via Postgres trigger (see migrations/)
model User {
  id            String   @id @db.Uuid
  email         String   @unique
  status        String   @default("active")
  platformRoles String[] @default([]) @map("platform_roles")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships TenantMembership[]
  apiKeys     ApiKey[]

  @@map("users")
  @@schema("oweibo")
}

// Tenant-scoped; RLS on tenant_id
model TenantMembership {
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roles     String[]
  invitedAt DateTime @default(now()) @map("invited_at") @db.Timestamptz
  invitedBy String?  @map("invited_by") @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, tenantId])
  @@map("tenant_memberships")
  @@schema("oweibo")
}

// Tenant-scoped; RLS on tenant_id
model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  name            String
  prefix          String
  hashedSecret    String    @map("hashed_secret")
  scopes          String[]
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [createdByUserId], references: [id])

  @@map("api_keys")
  @@schema("oweibo")
}

// Audit log: append-only, partitioned by month; RLS on tenant_id
// Inserts go through oweibo.append_audit() SECURITY DEFINER function only.
model AuditLog {
  id               String   @id @db.Uuid
  ts               DateTime @db.Timestamptz
  actorPrincipal   String   @map("actor_principal")
  onBehalfOfUserId String?  @map("on_behalf_of_user_id") @db.Uuid
  source           String
  requestId        String?  @map("request_id")
  ip               String?
  tenantId         String?  @map("tenant_id") @db.Uuid
  scopeUsed        String[] @map("scope_used")
  action           String
  resourceType     String?  @map("resource_type")
  resourceId       String?  @map("resource_id")
  beforeHash       String?  @map("before_hash")
  afterHash        String?  @map("after_hash")
  outcome          String
  details          Json?

  @@map("audit_log")
  @@schema("oweibo")
}

// ── Phase A: prompt versioning + task tracking ──────────────────────────────

// Tenant-scoped task. All prompt-version pins are written atomically with the INSERT.
model Task {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  sessionId               String?   @map("session_id")
  taskMode                String    @default("factory") @map("task_mode")
  goalDescription         String    @map("goal_description")
  goalContext             String?   @map("goal_context")
  repoPath                String?   @map("repo_path")
  status                  String    @default("pending")
  result                  Json?
  error                   String?
  tokensUsed              Int       @default(0) @map("tokens_used")
  ttlSeconds              Int?      @map("ttl_seconds")
  architectAssembledHash  String?   @map("architect_assembled_hash")
  executorAssembledHash   String?   @map("executor_assembled_hash")
  reviewerAssembledHash   String?   @map("reviewer_assembled_hash")
  decomposerAssembledHash String?   @map("decomposer_assembled_hash")
  slotPinDetail           Json?     @map("slot_pin_detail")
  cohortChannel           String    @default("stable") @map("cohort_channel")
  projectId               String?   @map("project_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt               DateTime? @map("started_at") @db.Timestamptz
  completedAt             DateTime? @map("completed_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  feedback TaskFeedback[]

  @@map("tasks")
  @@schema("oweibo")
}

// Platform-wide participation settings per tenant (no RLS on columns — full row is tenant-scoped)
model TenantSettings {
  tenantId                        String    @id @map("tenant_id") @db.Uuid
  participateInPatternBank        Boolean   @default(false) @map("participate_in_pattern_bank")
  patternBankEnabledAt            DateTime? @map("pattern_bank_enabled_at") @db.Timestamptz
  patternBankEligibilityCheckedAt DateTime? @map("pattern_bank_eligibility_checked_at") @db.Timestamptz
  updatedAt                       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
  @@schema("oweibo")
}

// Content-addressed prompt slot versions. hash = SHA256(role:slot_id:template_version:text)
model PromptVersion {
  hash            String   @id
  role            String
  slotId          String   @map("slot_id")
  templateVersion String   @default("stable-v0") @map("template_version")
  text            String
  parentHash      String?  @map("parent_hash")
  mutationStatus  String   @default("stable") @map("mutation_status")
  freezeReason    String?  @map("freeze_reason")
  evalScore       Json?    @map("eval_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by")

  parent   PromptVersion?  @relation("PromptVersionLineage", fields: [parentHash], references: [hash])
  children PromptVersion[] @relation("PromptVersionLineage")
  channels Channel[]

  @@map("prompt_versions")
  @@schema("oweibo")
}

// Per-role, per-slot channel pointer with optimistic-lock version.
model Channel {
  name       String   @map("name")
  role       String
  slotId     String   @map("slot_id")
  promptHash String   @map("prompt_hash")
  version    BigInt   @default(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy  String?  @map("updated_by")

  promptVersion PromptVersion @relation(fields: [promptHash], references: [hash])

  @@id([name, role, slotId])
  @@map("channels")
  @@schema("oweibo")
}

// Thumbs feedback — tenant-scoped, written via POST /api/tasks/:id/feedback
model TaskFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  signal    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task   Task   @relation(fields: [taskId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("task_feedback")
  @@schema("oweibo")
}

// Outbox: atomic state-mutation + bus publish
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  ts          DateTime  @default(now()) @db.Timestamptz
  subject     String
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox")
  @@schema("oweibo")
}

// T.−1: per-(tenant, action_class) trust state for the action trust ladder.
// Zero rows means the resolver applies the platform-default matrix.
model TenantActionClassState {
  tenantId     String   @map("tenant_id") @db.Uuid
  actionClass  String   @map("action_class")
  currentMode  String   @map("current_mode")
  pinnedBy     String?  @map("pinned_by")
  pinnedReason String?  @map("pinned_reason")
  observations Int      @default(0)
  successes    Int      @default(0)
  rejections   Int      @default(0)
  lastUpdated  DateTime @default(now()) @map("last_updated") @db.Timestamptz

  @@id([tenantId, actionClass])
  @@map("tenant_action_class_state")
  @@schema("oweibo")
}

// T.0: tenant bootstrap lifecycle state machine — one row per provisioned tenant.
model TenantBootstrap {
  tenantId     String    @id @map("tenant_id") @db.Uuid
  state        String    @default("pending")
  templateSlug String    @default("default") @map("template_slug")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_bootstrap")
  @@schema("oweibo")
}

// T.0: per-step bootstrap status. PK (tenant_id, step_name) makes step retries safe.
model TenantBootstrapStep {
  tenantId    String    @map("tenant_id") @db.Uuid
  stepName    String    @map("step_name")
  status      String
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  result      Json?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  @@id([tenantId, stepName])
  @@map("tenant_bootstrap_steps")
  @@schema("oweibo")
}

// T.−1: append-only proposals for dry_run / shadow / require_approval gate decisions.
model ActionProposal {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  actionClass    String    @map("action_class")
  actionId       String    @map("action_id")
  mode           String
  summary        String
  payload        Json
  rollbackKind   String?   @map("rollback_kind")
  rollbackDetail Json?     @map("rollback_detail")
  state          String    @default("pending")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz
  decisionReason String?   @map("decision_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz

  @@unique([tenantId, actionId])
  @@map("action_proposals")
  @@schema("oweibo")
}
