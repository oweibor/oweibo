{
  "name": "@oweibo/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Oweibo Chrome Extension — Manifest V3 chrome.debugger bridge for one-click consumer browser attachment (v9.5.8).",
  "scripts": {
    "build":      "webpack --config webpack.config.js && node scripts/copy-static.mjs",
    "build:prod": "node -e \"process.env.NODE_ENV='production';require('child_process').execSync('webpack --config webpack.config.js',{stdio:'inherit'})\" && node scripts/copy-static.mjs",
    "watch":      "webpack --config webpack.config.js --watch",
    "type-check": "tsc --noEmit",
    "clean":      "rimraf build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "rimraf": "^5.0.0"
  }
}
