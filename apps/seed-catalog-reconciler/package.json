{
  "name": "@oweibo/seed-catalog-reconciler",
  "version": "0.1.0",
  "private": true,
  "description": "T.7 — Daily cron that diffs the platform seed catalog against per-tenant installs and surfaces pending updates.",
  "main": "./dist/index.js",
  "scripts": {
    "build":      "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "start":      "node dist/index.js",
    "test":       "jest --passWithNoTests",
    "clean":      "rimraf dist"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "pg":        "^8.13.3"
  },
  "devDependencies": {
    "@types/node":      "^20.0.0",
    "@types/pg":        "^8.11.10",
    "@types/jest":      "^29.5.13",
    "@types/node-cron": "^3.0.11",
    "jest":             "^29.7.0",
    "ts-jest":          "^29.2.5",
    "rimraf":           "^5.0.0",
    "typescript":       "^5.5.4"
  }
}
