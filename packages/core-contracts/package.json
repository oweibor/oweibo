{
  "name": "@oweibo/core-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency TypeScript contracts for all oweibo packages. The ONLY legal import source for module-* packages.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@oweibo/channel-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
