    "typescript":           "^5.5.4",
    "vitest":               "^2.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@playwright/test":     "^1.48.0",
    "eslint":               "^9.0.0",
    "eslint-config-next":   "^15.1.0"
  }
