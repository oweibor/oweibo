{
  "name": "@oweibo/identity",
  "version": "0.1.0",
  "private": true,
  "description": "BetterAuth identity service: JWKS, JWT mint/verify, platform and tenant admin endpoints",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@oweibo/api-middleware": "workspace:*",
    "@oweibo/core-contracts": "workspace:*",
    "@oweibo/db": "workspace:*",
    "better-auth": "^1.1.0",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8",
    "winston": "^3.14.0",
    "uuid": "^10.0.0",
    "crypto": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
