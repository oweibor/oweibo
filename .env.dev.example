# .env.dev.example — local platform bring-up.
#
#   cp .env.dev.example .env.dev      # .env.dev is gitignored
#   pnpm gen:keys                     # fills JWT_PRIVATE_KEY / JWT_PUBLIC_KEY
#
# Loaded per-service via Node's --env-file (see the root package.json scripts
# and README "Getting started"). These are DEV defaults — never use in prod.

# ── Data plane (matches docker-compose.dev.yml) ────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oweibo
REDIS_URL=redis://localhost:6379

# ── Identity service (apps/identity, :3110) ────────────────────────────────
NODE_ENV=development
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
BETTER_AUTH_BASE_URL=http://localhost:3110
TRUSTED_ORIGINS=http://localhost:3120,http://localhost:3110
JWT_KEY_ID=oweibo-rs256-dev
JWT_ISSUER=https://identity.oweibo.io
JWT_AUDIENCE=oweibo-api
# Filled by `pnpm gen:keys` — leave blank in the template:
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── admin-web (apps/admin-web, :3120) — code defaults already match these ──
IDENTITY_URL=http://localhost:3110
PIPELINE_URL=http://localhost:3100/api/v1

# ── seed-admin (first platform_admin) ──────────────────────────────────────
ADMIN_EMAIL=admin@oweibo.local
ADMIN_PASSWORD=ChangeMe-12345!

# ── core-engine API (:3100) — only needed for step 2 (tenant/task pages) ───
OWEIBO_INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
