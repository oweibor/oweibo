{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitAny": false,
    "paths": {
      "@oweibo/core-contracts": ["../core-contracts/dist/index.d.ts"],
      "@oweibo/core-contracts/testing": ["../core-contracts/src/testing/index.ts"],
      "@oweibo/channel-contracts": ["../channel-contracts/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/__tests__/**"]
}
