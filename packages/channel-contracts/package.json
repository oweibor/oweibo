{
  "name": "@oweibo/channel-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency channel platform types (v9.3). Imported by core-contracts and channel-gateway to avoid circular deps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
