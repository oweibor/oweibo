# Agent Factory Configuration Template
# Rename this file to 'config.env' in the same directory as setup.sh to pre-load values.
# This file is also written by the onboarding wizard — do not edit manually if using the wizard.

# =============================================================================
# TIMEZONE & NETWORK
# =============================================================================

# Timezone (e.g. America/New_York)
# Leave empty to auto-detect from system
TIMEZONE=

# Network Interface Override
# Leave empty to auto-detect
INTERFACE=

# =============================================================================
# USER & PERMISSIONS
# =============================================================================

# User ID (run 'id' command to find your UID)
PUID=1000

# Group ID (run 'id' command to find your GID)
PGID=1000

# =============================================================================
# HARDWARE CLASSIFICATION (written by onboarding wizard)
# =============================================================================

# Hardware profile for AI pipeline constraints:
# n100_like (Intel N95/N97/N100/N200), n305 (Intel N305 8-core), celeron,
# core_i3, core_i5, core_i7, amd_low, amd_mid, amd_high,
# arm64_rpi5, arm64_server, arm64_rk3588,
# nvidia_small (4GB), nvidia_medium (8GB), nvidia_large (12-24GB), apple_silicon
HARDWARE_PROFILE=

# Hardware speed classification: INSUFFICIENT, CPU_MARGINAL, IGPU_OK, GPU_GOOD, GPU_GREAT
SPEED_CLASS=

# Resource tier: MINIMAL, LOW, MID, HIGH, ULTRA
RESOURCE_TIER=

# GPU VRAM in GB (detected automatically)
GPU_VRAM_GB=0

# =============================================================================
# OLLAMA MODELS (written by onboarding wizard)
# =============================================================================

# Model for coding/architect/orchestrator roles
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b

# Model for planning/reasoning/general tasks
OLLAMA_GENERAL_MODEL=llama3.2:3b

# Model for delegation/fast/quick tasks
OLLAMA_QUICK_MODEL=llama3.2:1b

# Combined model list for setup.sh pull loop (space-separated)
OLLAMA_MODEL=qwen2.5-coder:3b llama3.2:3b llama3.2:1b

# =============================================================================
# OLLAMA PERFORMANCE TUNING (written by onboarding wizard)
# =============================================================================

# CPU threads - formula: 75% of physical cores, max 12
OLLAMA_NUM_THREADS=4

# Flash attention - 0 for CPU, 1 for GPU/Metal
OLLAMA_FLASH_ATTENTION=0

# KV cache type - q8_0 recommended
OLLAMA_KV_CACHE_TYPE=q8_0

# Parallel requests per model
OLLAMA_NUM_PARALLEL=1

# Max models loaded at once
OLLAMA_MAX_LOADED_MODELS=1

# GPU layers - 999 for full offload, 0 for CPU-only
OLLAMA_NUM_GPU=0

# Keep model warm for N minutes after use
OLLAMA_KEEP_ALIVE=5m

# Enable Metal on Apple Silicon (1 = enabled)
OLLAMA_METAL=0

# Memory limit for Ollama container (supports: 2g, 4g, 6g, 8g)
OLLAMA_MEM_LIMIT=4g

# Context windows per role
OLLAMA_CTX_CODING=8192
OLLAMA_CTX_GENERAL=4096
OLLAMA_CTX_QUICK=2048

# =============================================================================
# AI MODE & TRUST (written by onboarding wizard)
# =============================================================================

# AI mode: local, hybrid, cloud-primary
AI_MODE=local

# Kilo trust mode: supervised, graduated, autonomous
TRUST_MODE=supervised

# =============================================================================
# CRAWL4AI WEB RESEARCH PIPELINE
# =============================================================================

# Crawl4AI API token (optional, leave empty for local)
CRAWL4AI_API_TOKEN=

# Max concurrent requests (hardware-aware, auto-configured)
CRAWL4AI_MAX_CONCURRENT=

# Request timeout in milliseconds
CRAWL4AI_TIMEOUT=30000

# Memory limit for Crawl4AI container (supports: 512m, 800m, 1g, 2g)
CRAWL4AI_MEMORY_LIMIT=800m

# Qdrant collection for scraped content
SCRAPE_QDRANT_COLLECTION=scraped_content

# =============================================================================
# AUTONOMY & NOTIFICATIONS
# =============================================================================

# Webhook URL for task completion notifications
# Supports: Slack incoming webhook, Telegram bot URL, email relay endpoint
NOTIFY_WEBHOOK=

# Enable persistent agent mode (agent continues when user disconnects)
PERSISTENT_MODE=true

# Enable task queue (agent queues and executes tasks sequentially)
TASK_QUEUE_ENABLED=true

# =============================================================================
# SELF-IMPROVEMENT (optional — defaults shown)
# =============================================================================

# Memory Decay: cron schedule (default: weekly, Sunday 03:00)
DECAY_CRON=0 3 * * 0

# Memory Decay: days since last use before a rule is demoted (default: 90)
DECAY_STALE_DAYS=90

# Memory Decay: false-positive rate threshold for demotion, 0-1 (default: 0.30)
DECAY_FP_THRESHOLD=0.30

# Idle Reflection: cron schedule (default: every hour on the hour)
IDLE_REFLECTION_CRON=0 * * * *

# Idle Reflection: max quarantine tasks per LLM batch (default: 10)
REFLECTION_BATCH_SIZE=10

# Curriculum Learning: cron schedule (default: Monday 06:00)
CURRICULUM_CRON=0 6 * * 1

# Curriculum Learning: max packages to check per run (default: 20)
CURRICULUM_MAX_PKGS=20

# Curriculum Learning: GitHub personal access token (optional, avoids rate limits)
GITHUB_TOKEN=

# =============================================================================
# SERVICE CREDENTIALS (generated by setup.sh)
# =============================================================================

# Kilo CLI API Key (for AI orchestration, optional — single-tenant legacy mode)
KILO_API_KEY=

# =============================================================================
# MULTI-TENANT SECURITY
# =============================================================================

# Per-tenant API token map (JSON).  Overrides KILO_API_KEY for multi-tenant.
# Format: {"<bearer-token>":"<tenantId>", ...}
# Generate tokens: openssl rand -hex 32
TENANT_TOKENS=

# Base directory for tenant workspace isolation.
# All workspace_path values must be children of WORKSPACE_ROOT/<tenantId>/.
WORKSPACE_ROOT=/var/kilo/workspaces

# Per-tenant concurrency cap (prevents one tenant starving others).
# Global MAX_CONCURRENCY is still the outer bound.
TENANT_MAX_CONCURRENCY=2

# SearXNG secret key — generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=

# OpenClaw gateway token — generate with: openssl rand -hex 16
OPENCLAW_TOKEN=

# =============================================================================
# MULTI-PROVIDER LLM (optional — defaults to local Ollama)
# =============================================================================

# Active LLM backend: ollama (default) | openai | anthropic | openrouter | deepseek
LLM_PROVIDER=ollama

# Per-call deadline in milliseconds (default: 120000)
# Low-power hardware (N100): keep at 120000+
# Cloud providers: 30000–60000 is usually sufficient
LLM_TIMEOUT_MS=120000

# Model override — leave empty to use each provider's built-in default
# ollama default:     qwen2.5-coder:3b (or OLLAMA_DEFAULT_MODEL)
# openai default:     gpt-4o-mini
# anthropic default:  claude-haiku-4-5-20251001
# openrouter default: mistralai/mistral-7b-instruct
# deepseek default:   deepseek-chat
LLM_MODEL=

# Cloud provider API keys (only required when the matching LLM_PROVIDER is active)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Base URL overrides — leave empty to use official endpoints
# Useful for proxies, local LiteLLM deployments, or Azure OpenAI
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
OPENROUTER_BASE_URL=
DEEPSEEK_BASE_URL=

# HTTP-Referer sent to OpenRouter (identifies your app in their dashboard)
OPENROUTER_REFERER=https://kilo.local

# =============================================================================
# PHASE A: PROMPT REGISTRY (self-improving platform)
# =============================================================================

# HMAC-SHA256 key used to sign and verify frame templates (required for PromptAssembler).
# MUST be a high-entropy secret (32+ random bytes). Rotate requires re-signing templates.
# Generate: openssl rand -hex 32
FRAME_SIGNING_KEY=

# Langfuse observability (already used by core-engine; also used by PromptRegistry mirror)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_SAMPLING_RATE=1.0
LANGFUSE_FLUSH_AT=10
LANGFUSE_FLUSH_INTERVAL_MS=5000
