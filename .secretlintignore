# Mirror .gitignore: secretlint scans **/* and would otherwise flag content
# in directories git already ignores (e.g. third-party reference projects
# placed under plans/).
plans/**
node_modules/**
*.tsbuildinfo
dist/**
**/dist/**
.next/**
**/.next/**
config.env*

# .env.dev* mirrors .gitignore's !.env.dev.example / .env.dev entries: the
# example is a committed template with placeholder dev-only values, and
# .env.dev itself is git-ignored generated local state that secretlint's
# whole-tree scan would otherwise still flag.
.env.dev*
