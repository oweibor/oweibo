{
  "name": "@oweibo/connector-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "D.4 (domain-depth) — author SDK for oweibo connectors. Type-safe declareConnector(), contract validator, and a runCertificationSuite test harness used by CI to gate connector PRs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@oweibo/core-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.4"
  }
}
