{
  "name": "@oweibo/api-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Express middleware for all oweibo gateway services: authenticate, requireScopes, requireTenantMatch, audit, idempotent, rateLimit, requestId",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@oweibo/db": "workspace:*",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "jose": "^5.9.0",
    "zod": "^3.23.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "peerDependencies": {
    "express": "^4.x"
  }
}
