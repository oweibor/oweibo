{
  "name": "@oweibo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client, RLS migrations, and withTenantContext chokepoint for oweibo.*",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "vitest": "^2.0.5"
  }
}
